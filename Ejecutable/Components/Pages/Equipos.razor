@page "/equipos"
@rendermode InteractiveServer
@inject EquipoServicio EquipoServicio
@inject IServicioSesion ServicioSesion
@inject Sistema.Interfaces.IServicioRoles ServicioRoles
@inject NavigationManager Navigation
@using Sistema
@using Sistema.Interfaces
@using Dominio
@using Sistema.DTOs

<PageTitle>Equipos</PageTitle>

@if (!paginaCargada)
{
    <div class="d-flex justify-content-center mt-5">
        <div class="spinner-border" role="status"></div>
    </div>
}
else
{
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Equipos</h3>
            @if (esAdmin)
            {
                <button class="btn btn-primary" @onclick="AbrirFormularioAlta">
                    + Nuevo equipo
                </button>
            }
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger alert-dismissible">
                @mensajeError
                <button type="button" class="btn-close" @onclick="@(() => mensajeError = string.Empty)"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alert alert-success alert-dismissible">
                @mensajeExito
                <button type="button" class="btn-close" @onclick="@(() => mensajeExito = string.Empty)"></button>
            </div>
        }

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Bandera</th>
                    <th>Nombre</th>
                    <th>Confederación</th>
                    <th>Ranking FIFA</th>
                    <th>Ranking Actual</th>
                    @if (esAdmin)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (EquipoDTO equipo in equipos)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(equipo.BanderaBase64))
                            {
                                <img src="data:image/*;base64,@equipo.BanderaBase64"
                                     height="30" alt="@equipo.Nombre" />
                            }
                        </td>
                        <td>@equipo.Nombre</td>
                        <td>@equipo.Confederacion</td>
                        <td>@equipo.RankingFIFA</td>
                        <td>@equipo.RankingActual</td>
                        @if (esAdmin)
                        {
                            <td>
                                <button class="btn btn-sm btn-outline-secondary me-1"
                                        @onclick="@(() => AbrirFormularioEdicion(equipo))">
                                    Editar
                                </button>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="@(() => Eliminar(equipo.Id))">
                                    Eliminar
                                </button>
                            </td>
                        }
                    </tr>
                }
                @if (!equipos.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">
                            No hay equipos cargados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (mostrarFormulario)
        {
            <div class="card mt-4">
                <div class="card-header">
                    <strong>@(esNuevo ? "Nuevo equipo" : "Editar equipo")</strong>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nombre *</label>
                            <input class="form-control"
                                   @bind="formNombre"
                                   placeholder="Nombre del equipo" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Confederación *</label>
                            <select class="form-select" @bind="formConfederacion">
                                @foreach (Confederacion c in Enum.GetValues<Confederacion>())
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Ranking FIFA * (300–2500)</label>
                            <input type="number"
                                   class="form-control"
                                   @bind="formRankingFIFA"
                                   min="300"
                                   max="2500" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Bandera (imagen, opcional)</label>
                            <InputFile OnChange="OnBanderaChanged" accept="image/*" class="form-control" />
                            @if (!string.IsNullOrEmpty(formBandera))
                            {
                                <img src="data:image/*;base64,@formBandera"
                                     height="40" class="mt-2" alt="Previsualización" />
                            }
                        </div>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-success me-2" @onclick="Guardar">Guardar</button>
                        <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<EquipoDTO> equipos = new List<EquipoDTO>();
    private bool mostrarFormulario;
    private bool paginaCargada;
    private bool esNuevo;
    private bool esAdmin;
    private int editandoId;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;

    private string formNombre = string.Empty;
    private Confederacion formConfederacion = Confederacion.UEFA;
    private int formRankingFIFA = 300;
    private string formBandera = string.Empty;

    protected override void OnInitialized()
    {
        if (!ServicioSesion.EstaLogueado)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        esAdmin = ServicioRoles.EsAdmin();

        CargarEquipos();
        paginaCargada = true;
    }

    private void CargarEquipos() =>
        equipos = EquipoServicio.ObtenerTodos();

    private void AbrirFormularioAlta()
    {
        esNuevo = true;
        editandoId = 0;
        formNombre = string.Empty;
        formConfederacion = Confederacion.UEFA;
        formRankingFIFA = 300;
        formBandera = string.Empty;
        mensajeError = string.Empty;
        mostrarFormulario = true;
    }

    private void AbrirFormularioEdicion(EquipoDTO equipo)
    {
        esNuevo = false;
        editandoId = equipo.Id;
        formNombre = equipo.Nombre;
        formConfederacion = equipo.Confederacion;
        formRankingFIFA = equipo.RankingFIFA;
        formBandera = equipo.BanderaBase64 ?? string.Empty;
        mensajeError = string.Empty;
        mostrarFormulario = true;
    }

    private void Guardar()
    {
        try
        {
            string email = ServicioSesion.ObtenerUsuarioActual().CorreoElectronico;
            EquipoDTO equipoDTO = new EquipoDTO
            {
                Id = editandoId,
                Nombre = formNombre,
                Confederacion = formConfederacion,
                RankingFIFA = formRankingFIFA,
                RankingActual = formRankingFIFA,
                BanderaBase64 = formBandera
            };
            if (esNuevo)
                EquipoServicio.Agregar(equipoDTO, email);
            else
                EquipoServicio.Actualizar(equipoDTO, email);

            mensajeExito = esNuevo ? "Equipo creado." : "Equipo modificado.";
            mostrarFormulario = false;
            CargarEquipos();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }

    private void Eliminar(int id)
    {
        try
        {
            string email = ServicioSesion.ObtenerUsuarioActual().CorreoElectronico;
            EquipoServicio.Eliminar(id, email);
            mensajeExito = "Equipo eliminado.";
            CargarEquipos();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }

    private async Task OnBanderaChanged(InputFileChangeEventArgs e)
    {
        using MemoryStream ms = new MemoryStream();
        await e.File.OpenReadStream(maxAllowedSize: 512 * 1024).CopyToAsync(ms);
        formBandera = Convert.ToBase64String(ms.ToArray());
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        mensajeError = string.Empty;
    }

    private bool TienePermiso(string roleName) => ServicioRoles.TienePermiso(roleName);
}
