@using Sistema
@using Sistema.Interfaces
@using Sistema.DTOs
@inject IServicioSesion ServicioSesion
@inject IServicioUsuario ServicioUsuario
@inject IServicioRoles ServicioRoles
@inject NavigationManager Navigation
@inject Sistema.NotificacionServicio NotificacionServicio
@implements IDisposable
@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div>
        <NavLink>
            <span class="bi bi-person-circle"></span>
            @{ var usuarioDto = ServicioSesion.UsuarioActual != null ? UsuarioDTO.convertirAUsuarioDTO(ServicioSesion.ObtenerUsuarioActual()) : null; }
            <a class="navbar-brand fw-bold" href="perfil">
                @usuarioDto?.Nombre @usuarioDto?.Apellido
            </a>
        </NavLink>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

@if (EsAdmin)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="usuarios">
            <span class="bi bi-people-fill" aria-hidden="true"></span> Usuarios
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="estadios">
            <span class="bi bi-building" aria-hidden="true"></span> Estadios
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="logs">
            <span class="bi bi-journal-text" aria-hidden="true"></span> Logs
        </NavLink>
    </div>
}

@if (EsPeriodista)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="notificaciones">
            <span class="bi bi-bell-fill" aria-hidden="true"></span> Notificaciones
            @if (_notifNoLeidas > 0)
            {
                <span class="badge rounded-pill bg-danger ms-1" style="font-size:0.65rem">
                    @(_notifNoLeidas > 99 ? "99+" : _notifNoLeidas.ToString())
                </span>
            }
        </NavLink>
    </div>
}


@if (EsEditor || EsPeriodista)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="equipos">
            <span class="bi bi-flag-fill" aria-hidden="true"></span> Equipos
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="fixture">
            <span class="bi bi-calendar3" aria-hidden="true"></span> Fixture
        </NavLink>
    </div>
}

@if (EsEditor)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="partidos">
            <span class="bi bi-trophy-fill" aria-hidden="true"></span> Partidos
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="cruces">
            <span class="bi bi-diagram-3-fill" aria-hidden="true"></span> Eliminatorias
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="importar">
            <span class="bi bi-upload" aria-hidden="true"></span> Importar
        </NavLink>
    </div>
}

@if (EsAdmin || EsPeriodista)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="exportacion">
            <span class="bi bi-download" aria-hidden="true"></span> Exportación
        </NavLink>
    </div>
}

        <div class="nav-item px-3 mt-3">
            <a class="nav-link text-danger" href="" @onclick="CerrarSesion" @onclick:preventDefault="true">
                <span class="bi bi-box-arrow-left" aria-hidden="true"></span> Cerrar sesión
            </a>
        </div>

    </nav>
</div>

@code {
    private bool EsAdmin => ServicioSesion.UsuarioActual is not null && ServicioRoles.EsAdmin();

    private bool EsEditor => ServicioSesion.UsuarioActual is not null && ServicioRoles.EsEditor();

    private bool EsPeriodista => ServicioSesion.UsuarioActual
        is not null && TienePermiso("Periodista");

    private int _notifNoLeidas = 0;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        ActualizarContador();
        _timer = new System.Threading.Timer(_ =>
            InvokeAsync(() => { ActualizarContador(); StateHasChanged(); }),
            null, TimeSpan.FromSeconds(20), TimeSpan.FromSeconds(20));
    }

    private void ActualizarContador()
    {
        try { _notifNoLeidas = NotificacionServicio.ObtenerNoLeidas().Count; }
        catch { _notifNoLeidas = 0; }
    }

    public void Dispose() => _timer?.Dispose();

    private void CerrarSesion()
    {
        ServicioUsuario.CerrarSesion();
        Navigation.NavigateTo("/login");
    }

    private bool TienePermiso(string roleName) => ServicioRoles.TienePermiso(roleName);
}
